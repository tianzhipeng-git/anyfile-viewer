{
  "name": "anyfile-viewer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "scripts": {
    "prepare:pdfjs": "node scripts/prepare-pdfjs-assets.mjs",
    "prepare:heif": "node scripts/prepare-heif-assets.mjs",
    "prepare:ogv": "node scripts/prepare-ogv-assets.mjs",
    "prepare:assets": "pnpm prepare:pdfjs && pnpm prepare:heif && pnpm prepare:ogv",
    "dev": "pnpm prepare:assets && next dev",
    "build": "pnpm prepare:assets && next build --webpack && pnpm check:bundle",
    "check:bundle": "node scripts/check-view-bundle.mjs",
    "measure:video-probes": "node scripts/measure-video-probes.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "pnpm test:app && pnpm --recursive --if-present test",
    "test:app": "vitest run"
  },
  "dependencies": {
    "@anyfile/archive-metadata-viewer": "workspace:*",
    "@anyfile/browser-image-viewer": "workspace:*",
    "@anyfile/browser-video-viewer": "workspace:*",
    "@anyfile/camera-raw-viewer": "workspace:*",
    "@anyfile/code-viewer": "workspace:*",
    "@anyfile/data-viewer": "workspace:*",
    "@anyfile/dev-array-viewer": "workspace:*",
    "@anyfile/dev-source-map-viewer": "workspace:*",
    "@anyfile/dev-wasm-viewer": "workspace:*",
    "@anyfile/excel-viewer": "workspace:*",
    "@anyfile/general-raster-viewer": "workspace:*",
    "@anyfile/har-viewer": "workspace:*",
    "@anyfile/hex-viewer": "workspace:*",
    "@anyfile/modern-raster-viewer": "workspace:*",
    "@anyfile/non-native-video-viewer": "workspace:*",
    "@anyfile/pdf-viewer": "workspace:*",
    "@anyfile/powerpoint-viewer": "workspace:*",
    "@anyfile/safe-svg-viewer": "workspace:*",
    "@anyfile/sqlite-viewer": "workspace:*",
    "@anyfile/viewer-protocol": "workspace:*",
    "@anyfile/viewer-rendering": "workspace:*",
    "@anyfile/word-viewer": "workspace:*",
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libraw-wasm": "1.6.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "happy-dom": "20.11.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
