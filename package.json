{
  "name": "anyfile-viewer",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "viewer/protocol",
    "viewer/rendering",
    "viewer/testing",
    "viewer/ui",
    "viewer/plugins/*"
  ],
  "scripts": {
    "prepare:pdfjs": "node scripts/prepare-pdfjs-assets.mjs",
    "prepare:heif": "node scripts/prepare-heif-assets.mjs",
    "prepare:assets": "npm run prepare:pdfjs && npm run prepare:heif",
    "dev": "npm run prepare:assets && next dev",
    "build": "npm run prepare:assets && next build --webpack && npm run check:bundle",
    "check:bundle": "node scripts/check-view-bundle.mjs",
    "measure:video-probes": "node scripts/measure-video-probes.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:app && npm test --workspaces --if-present",
    "test:app": "vitest run"
  },
  "dependencies": {
    "@anyfile/archive-metadata-viewer": "*",
    "@anyfile/browser-video-viewer": "*",
    "@anyfile/code-viewer": "*",
    "@anyfile/data-viewer": "*",
    "@anyfile/excel-viewer": "*",
    "@anyfile/general-raster-viewer": "*",
    "@anyfile/har-viewer": "*",
    "@anyfile/hex-viewer": "*",
    "@anyfile/browser-image-viewer": "*",
    "@anyfile/camera-raw-viewer": "*",
    "@anyfile/modern-raster-viewer": "*",
    "@anyfile/pdf-viewer": "*",
    "@anyfile/powerpoint-viewer": "*",
    "@anyfile/sqlite-viewer": "*",
    "@anyfile/viewer-rendering": "*",
    "@anyfile/viewer-protocol": "*",
    "@anyfile/word-viewer": "*",
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "happy-dom": "20.11.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
