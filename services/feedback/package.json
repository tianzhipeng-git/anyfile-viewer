{
  "name": "@anyfile/feedback-service",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --include-runtime false",
    "check": "pnpm types && tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "pnpm build && node --test test/*.test.mjs",
    "db:local": "wrangler d1 migrations apply feedback --local",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260908.1",
    "miniflare": "5.20260908.0-alpha",
    "typescript": "^5",
    "wrangler": "4.130.0"
  }
}
